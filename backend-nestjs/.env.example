# Copy to `.env` and fill in. The app validates this contract at boot
# (src/config/env.validation.ts) and refuses to start if anything required is
# missing, reporting ALL missing variables at once.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | test | staging | production. Leave unset in doubt --
# unset is treated as NON-permissive (strict CORS), never as development.
NODE_ENV=development
# HTTP port for the API process.
PORT=3000
# api | worker -- which role this process plays; worker skips the HTTP server.
PROCESS_ROLE=api

# ---------------------------------------------------------------------------
# Required in EVERY environment
# ---------------------------------------------------------------------------
# Signing key for JWT access tokens. Use a long random string, never a default.
JWT_SECRET=change-me-to-a-long-random-string
# Postgres host for the main multi-tenant database.
DB_HOST=localhost
# Postgres port.
DB_PORT=5432
# Main database name.
DB_NAME=odiseo
# Postgres user.
DB_USER=postgres
# Postgres password (may be empty, but the variable must be present).
DB_PASS=postgres

# ---------------------------------------------------------------------------
# Required in production only (optional locally, dev defaults apply)
# ---------------------------------------------------------------------------
# S3 endpoint. Locally this points at LocalStack; in production it MUST be set.
AWS_S3_ENDPOINT=http://localhost:4566
# S3 bucket holding generated materials and PDFs.
AWS_S3_BUCKET=odiseo-materials
# AWS region for the S3 client.
AWS_REGION=us-east-1
# Google Cloud project owning the question-image bucket.
GOOGLE_CLOUD_PROJECT_ID=odiseo-api
# GCS bucket holding question images.
GOOGLE_CLOUD_STORAGE_BUCKET=dev_odiseo_bucket
# Redis host backing the BullMQ job queues.
REDIS_HOST=localhost
# Redis port.
REDIS_PORT=6379
# Root domain used to build the CORS allowlist (https://<domain> + subdomains).
BASE_DOMAIN=odiseo.com
# Domain the httpOnly auth cookie is scoped to.
COOKIE_DOMAIN=.odiseo.com
# Shared secret authenticating worker -> API webhook callbacks.
WORKER_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Access-token lifetime, e.g. `1d` or `3600s`.
JWT_EXPIRATION=1d
# Path to the GCS service-account JSON key file.
GOOGLE_CLOUD_KEY_FILE=./google-cloud-credentials.json
# Timeout in ms for a single GCS signed-URL attempt (3 attempts with backoff).
GCS_SIGNED_URL_TIMEOUT_MS=5000
# Database holding the shared question bank.
DB_QUESTIONS_BASE=odiseo_pro
# Legacy alias for the question-bank database name.
DB_QUESTIONS_NAME=odiseo_pro
# Pino log level: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info
